            b.BackgroundTransparency = 0.4
            b.TextColor3 = Util.color3(Theme.Current.Accent)
            for _, ch in ipairs(b:GetChildren()) do if ch:IsA("UIStroke") then ch.Transparency = 0 end end
        else
            b.BackgroundTransparency = 1
            b.TextColor3 = Util.color3(Theme.Current.Text)
            for _, ch in ipairs(b:GetChildren()) do if ch:IsA("UIStroke") then ch.Transparency = 1 end end
        end
    end
