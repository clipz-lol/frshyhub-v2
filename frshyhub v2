function Hub:bind(c) table.insert(self.conns, c) return c end
function Hub:destroy() for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end self.conns = {} end
function Hub:registerRefresh(fn) table.insert(self.uiRefreshers, fn) end
function Hub:refreshUI() for _, fn in ipairs(self.uiRefreshers) do pcall(fn) end end

function Hub:getHitboxPart(character, mode)
    if not character then return nil end
    if mode == "Head" then return character:FindFirstChild("Head") end
    if mode == "UpperTorso" then return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") end
    if mode == "LowerTorso" then return character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso") end
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

function Hub:isProtected(p)
    if not p then return false end
    for _, e in ipairs(self.state.ProtectedPlayers) do
        if type(e) == "table" then
            if e.Name == p.Name or e.UserId == p.UserId then return true end
        elseif e == p.Name then return true end
    end
    return false
end
function Hub:protectPlayer(p)
    if not p or self:isProtected(p) then return false end
    table.insert(self.state.ProtectedPlayers, {Name=p.Name, UserId=p.UserId})
    return true
end
function Hub:unprotectPlayer(p)
    for i = #self.state.ProtectedPlayers, 1, -1 do
        local e = self.state.ProtectedPlayers[i]
        local n = type(e) == "table" and e.Name or e
        local u = type(e) == "table" and e.UserId or nil
        if n == p.Name or (u and u == p.UserId) then table.remove(self.state.ProtectedPlayers, i) return true end
    end
    return false
end

