local Movement = {}
function Movement.fly(hub)
    local s = hub.state
    if not s.FlyEnabled then
        if hub.flags.flyActive then
            hub.flags.flyActive = false
            local hum = Core.getHumanoid(LocalPlayer)
            if hum then hum.PlatformStand = false end
        end
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = Core.getHumanoid(LocalPlayer)
    if not hrp or not hum then return end
    hub.flags.flyActive = true
    hum.PlatformStand = true
    local move = Vector3.new(0,0,0)
    local cf = Camera.CFrame
    local fwd = cf.LookVector * Vector3.new(1,0,1)
    local right = cf.RightVector * Vector3.new(1,0,1)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += fwd end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= fwd end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= right end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += right end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move -= Vector3.new(0,1,0) end
    if move.Magnitude > 0 then move = move.Unit * s.FlySpeed end
    hrp.Velocity = move
end
function Movement.noclip(hub)
    local s = hub.state
    if hub.flags.noclipState == s.NoclipEnabled then return end
    hub.flags.noclipState = s.NoclipEnabled
    local char = LocalPlayer.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = not s.NoclipEnabled end
    end
end
function Movement.infiniteJump(hub)
    if not hub.state.InfiniteJump then return end
    local hum = Core.getHumanoid(LocalPlayer)
    if hum and hum:GetState() == Enum.HumanoidStateType.Freefall and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

