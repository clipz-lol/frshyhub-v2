local function makePlayerList(parent, hub, opts)
    opts = opts or {}
    if opts.headerText then UI.button(parent, opts.headerText, function() end, 30) end
    local search = Instance.new("TextBox")
    search.Size = UDim2.new(1, 0, 0, 30)
    search.PlaceholderText = opts.placeholder or "🔎  Search players..."
    search.Text = ""
    search.TextColor3 = Util.color3(Theme.Current.Text)
    search.BackgroundColor3 = Util.color3(Theme.Current.Panel)
    search.Font = Enum.Font.Gotham
    search.TextSize = 12
    search.BorderSizePixel = 0
    search.LayoutOrder = #parent:GetChildren() + 1
    search.Parent = parent
    makeCorner(search, 6)
    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, 0, 0, 380)
    list.BackgroundTransparency = 1
    list.LayoutOrder = #parent:GetChildren() + 1
    list.Parent = parent
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4)
    layout.Parent = list
    local function refresh()
        for _, ch in ipairs(list:GetChildren()) do
            if ch:IsA("TextButton") or ch:IsA("TextLabel") then ch:Destroy() end
        end
        local filter = string.lower(search.Text)
        local found = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and Core.isAlive(p) then
                if filter == "" or string.find(string.lower(p.Name), filter, 1, true) then
                    found = true
                    local prot = opts.showProtect ~= false and hub:isProtected(p)
                    local distText = ""
                    if opts.showDistance ~= false then
                        local hrp = Core.getHRP(p)
                        if hrp then distText = string.format("  (%dm)", math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)) end
                    end
                    local b = Instance.new("TextButton")
                    b.Size = UDim2.new(1, 0, 0, 30)
                    b.BackgroundColor3 = Util.color3(Theme.Current.Panel)
                    b.Text = string.format("%s %s%s%s", opts.prefix or "👤", p.Name, distText, prot and "  🛡️" or "")
                    b.TextColor3 = Util.color3(Theme.Current.Text)
                    b.Font = Enum.Font.Gotham
                    b.TextSize = 12
                    b.TextXAlignment = Enum.TextXAlignment.Left
                    b.BorderSizePixel = 0
                    b.Parent = list
                    local pad = Instance.new("UIPadding") pad.PaddingLeft = UDim.new(0, 10) pad.Parent = b
                    makeCorner(b, 4)
                    b.MouseButton1Click:Connect(function()
                        pcall(function() if opts.onPlayerClick then opts.onPlayerClick(p, b) end end)
                    end)
                end
            end
        end
        if not found then
            local e = Instance.new("TextLabel")
            e.Size = UDim2.new(1, 0, 0, 30)
            e.Text = opts.emptyText or "No players found"
            e.TextColor3 = Color3.fromRGB(120,120,130)
            e.BackgroundTransparency = 1
            e.Font = Enum.Font.Gotham
            e.TextSize = 12
            e.Parent = list
        end
    end
    search:GetPropertyChangedSignal("Text"):Connect(refresh)
    task.spawn(function() while task.wait(2) do pcall(refresh) end end)
    task.defer(refresh)
    return refresh
end

