    -- Applies a loaded slot payload to the live state, with side-effects.
    local function applySlotPayload(data)
        if type(data) ~= "table" then return end

        -- Keybinds first (convert strings back to EnumItems)
        if type(data.Keybinds) == "table" then
            for a, kn in pairs(data.Keybinds) do
                for _, e in ipairs(Enum.KeyCode:GetEnumItems()) do
                    if e.Name == kn then s.Keybinds[a] = e break end
                end
            end
        end

        -- Everything else
        for k, v in pairs(data) do
            if k ~= "Keybinds" then s[k] = v end
        end

        -- Side-effects -------------------------------------------------

        -- Silent aim connection
        if s.AimbotEnabled and s.SilentAim then
            pcall(function() Aimbot:startSilent(hub) end)
        else
            pcall(function() Aimbot:stopSilent(hub) end)
        end

        -- Theme
        if s.ThemeName and Theme.Presets[s.ThemeName] then
            Theme.applyByName(s.ThemeName)
            pcall(function() UI.retheme() end)
        end

        -- ESP / attachments / name spoofer
        pcall(function() ESP:cleanupAll() end)
        pcall(function() hub:detach() end)

        if s.NameSpooferEnabled then
            pcall(function() Identity.stop(hub) Identity.start(hub) end)
        else
            pcall(function() Identity.stop(hub) end)
        end

        -- Movement state reset
        hub.flags.flyActive = false
        hub.flags.noclipState = nil

        -- Keybind row labels
        if hub.flags.keybindWaiting and hub.flags.keybindWaiting.refresh then
            pcall(hub.flags.keybindWaiting.refresh)
        end

        -- Refresh every registered UI element
        pcall(function() hub:refreshUI() end)
    end
