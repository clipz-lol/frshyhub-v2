function Hub:goLegit()
    Notify.push("Go Legit", "Removing all traces...", "warn")
    local s = self.state
    s.AimbotEnabled = false s.FlyEnabled = false s.NoclipEnabled = false
    s.RapidFireEnabled = false s.SuperFastShootEnabled = false
    s.WallBangEnabled = false s.SnapAimEnabled = false s.ESPEnabled = false
    s.InfiniteJump = false s.NameSpooferEnabled = false s.SilentAim = false
    s.AppearanceLock = false
    task.wait(0.1)
    pcall(function() Aimbot:stopSilent(self) end)
    self:detach()
    Identity.stop(self)
    if wbState.active then
        for o, v in pairs(wbState.originals) do pcall(function() if o and o.Parent then o.CanQuery = v end end) end
        wbState.originals = {}
        wbState.active = false
    end
    if rapidConn then rapidConn:Disconnect() rapidConn = nil end
    rapidRunning = false
    if sfConn then sfConn:Disconnect() sfConn = nil end
    sfRunning = false
    ESP:cleanupAll()
    self:destroy()
    Util.disconnectAll()
    for _, g in ipairs(CoreGui:GetChildren()) do
        if g.Name:match("^Hub_") or g.Name:match("^FOV_") or g.Name:match("^CH_") then
            pcall(function() g:Destroy() end)
        end
    end
    Notify.push("Go Legit", "Script removed.", "success")
end

