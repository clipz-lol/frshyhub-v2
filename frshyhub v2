    end))

    task.spawn(function()
        while task.wait(0.2) do pcall(function() hub:refreshUI() end) end
    end)

    local wm = Instance.new("TextLabel")
    wm.Size = UDim2.new(0, 300, 0, 30)
    wm.Position = UDim2.new(1, -310, 0, 10)
    wm.BackgroundColor3 = Util.color3(Theme.Current.Header)
    wm.BackgroundTransparency = 0.3
    wm.Text = "  ✦ FRShYHub V2  •  " .. LocalPlayer.Name .. "  ✦"
    wm.TextColor3 = Util.color3(Theme.Current.Accent)
    wm.Font = Enum.Font.GothamBold
    wm.TextSize = 13
    wm.BorderSizePixel = 0
    wm.Parent = gui
    makeCorner(wm, 6)
    hub:bind(RunService.RenderStepped:Connect(function()
        wm.Visible = s.ShowWatermark
        wm.TextColor3 = Util.color3(Theme.Current.Accent)
    end))

    if s.SilentAim and s.AimbotEnabled then Aimbot:startSilent(hub) end

    -- ============================================
    -- AUTO-LOAD SLOT ON BOOT
    -- ============================================
    task.defer(function()
        if not (Slots.AutoLoad.enabled and Slots.AutoLoad.slotId) then return end
        local slotData = Slots.load(Slots.AutoLoad.slotId)
        if slotData and slotData.data and hub.flags.applySlotPayload then
            task.wait(0.5) -- give UI a moment to finish building
            pcall(function() hub.flags.applySlotPayload(slotData.data) end)
            local nm = (Slots.Index[Slots.AutoLoad.slotId] and Slots.Index[Slots.AutoLoad.slotId].name) or Slots.AutoLoad.slotId
            Notify.push("Slots", "Auto-loaded: " .. nm, "success", 3)
        else
            Notify.push("Slots", "Auto-load slot missing", "warn", 3)
            Slots.clearAutoLoad()
        end
    end)

    Notify.push("FRShYHub V2", "Loaded successfully", "success")
    Notify.push("Tip", "RightShift to toggle menu", "info", 5)
    Notify.push("Tip", "Slots tab → ⚡ Set to auto-load", "info", 6)

    print("[FRShYHub V2] Loaded")
end

local bootOk, bootErr = pcall(main)
if not bootOk then
    warn("[FRShYHub] Boot failed: " .. tostring(bootErr))
end
