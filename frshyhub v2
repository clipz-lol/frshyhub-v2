Slots.AutoLoadFile = "FRShYHub_V2_AutoLoad.json"
Slots.AutoLoad = {enabled = false, slotId = nil}

function Slots.loadAutoLoad()
    local ok, data = pcall(function() return readfile(Slots.AutoLoadFile) end)
    if ok and data and data ~= "" then
        local ok2, d = pcall(function() return HttpService:JSONDecode(data) end)
        if ok2 and type(d) == "table" then
            Slots.AutoLoad.enabled = d.enabled == true
            Slots.AutoLoad.slotId  = d.slotId
            return true
        end
    end
    Slots.AutoLoad = {enabled = false, slotId = nil}
    return false
end

function Slots.saveAutoLoad()
    pcall(function()
        writefile(Slots.AutoLoadFile, HttpService:JSONEncode(Slots.AutoLoad))
    end)
end

function Slots.setAutoLoad(slotId)
    Slots.AutoLoad.slotId  = slotId
    Slots.AutoLoad.enabled = slotId ~= nil
    Slots.saveAutoLoad()
end

function Slots.clearAutoLoad()
    Slots.AutoLoad.enabled = false
    Slots.AutoLoad.slotId  = nil
    Slots.saveAutoLoad()
end

Slots.loadAutoLoad()

