local Combat = {}
local rapidRunning, rapidConn, sfRunning, sfConn = false, nil, false, nil
local function fireOnce()
    local m = UserInputService:GetMouseLocation()
    VirtualInputManager:SendMouseButtonEvent(m.X, m.Y, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(m.X, m.Y, 0, false, game, 0)
end
local RAPID_BURST = 30
function Combat.rapidFire(hub)
    local s = hub.state
    if s.RapidFireEnabled and not rapidRunning then
        rapidRunning = true
        rapidConn = RunService.Heartbeat:Connect(function()
            if not hub.state.RapidFireEnabled then return end
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                if hub.state.RapidFireDelay <= 0 then
                    for _ = 1, RAPID_BURST do pcall(fireOnce) end
                else
                    task.wait(hub.state.RapidFireDelay)
                    for _ = 1, RAPID_BURST do pcall(fireOnce) end
                end
            end
        end)
    elseif not s.RapidFireEnabled and rapidRunning then
        rapidRunning = false
        if rapidConn then rapidConn:Disconnect() rapidConn = nil end
    end
end
function Combat.superFast(hub)
    local s = hub.state
    if s.SuperFastShootEnabled and not sfRunning then
        sfRunning = true
        sfConn = RunService.RenderStepped:Connect(function()
            if not hub.state.SuperFastShootEnabled then return end
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then pcall(fireOnce) end
        end)
    elseif not s.SuperFastShootEnabled and sfRunning then
        sfRunning = false
        if sfConn then sfConn:Disconnect() sfConn = nil end
    end
end
local wbState = {active=false, originals={}}
function Combat.wallBang(hub)
    local s = hub.state
    if s.WallBangEnabled and not wbState.active then
        wbState.active = true
        wbState.originals = {}
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o:IsA("BasePart") then
                local isChar = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and o:IsDescendantOf(p.Character) then isChar = true break end
                end
                if not isChar then
                    wbState.originals[o] = o.CanQuery
                    o.CanQuery = false
                end
            end
        end
    elseif not s.WallBangEnabled and wbState.active then
        wbState.active = false
        for o, v in pairs(wbState.originals) do
            pcall(function() if o and o.Parent then o.CanQuery = v end end)
        end
        wbState.originals = {}
    end
end

