local ESP = {drawings = {}, chams = {}}
function ESP:cleanup(plr)
    if self.drawings[plr] then for _, d in pairs(self.drawings[plr]) do pcall(function() d:Remove() end) end self.drawings[plr] = nil end
    if self.chams[plr] then for _, h in pairs(self.chams[plr]) do pcall(function() h:Destroy() end) end self.chams[plr] = nil end
end
function ESP:cleanupAll()
    local ks = {}
    for k in pairs(self.drawings) do table.insert(ks, k) end
    for _, k in ipairs(ks) do self:cleanup(k) end
    ks = {}
    for k in pairs(self.chams) do table.insert(ks, k) end
    for _, k in ipairs(ks) do self:cleanup(k) end
end
function ESP:colorFor(p, s)
    if s.ESPColorMode == "Health" then
        local h = Core.getHumanoid(p)
        if h then
            local r = h.Health / math.max(h.MaxHealth, 1)
            if r > 0.75 then return Color3.fromRGB(50,220,120)
            elseif r > 0.5 then return Color3.fromRGB(255,230,0)
            elseif r > 0.25 then return Color3.fromRGB(255,150,40)
            else return Color3.fromRGB(255,60,60) end
        end
        return Color3.fromRGB(255,255,255)
    elseif s.ESPColorMode == "Custom" then return Util.color3(s.ESPCustomColor)
    elseif s.ESPColorMode == "Accent" then return Util.color3(Theme.Current.Accent)
    else
        if LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then return Color3.fromRGB(60,220,120) end
        return Color3.fromRGB(255,60,80)
    end
end
function ESP:shouldDraw(p, s, hub)
    if not s.ESPEnabled then return false end
    if p == LocalPlayer and not s.ESPShowLocal then return false end
    if not Core.isAlive(p) then return false end
    if s.ESPFriendCheck and hub and hub:isProtected(p) then return false end
    if s.ESPTeamCheck and LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then return false end
    return true
end
function ESP:create(p, s)
    if self.drawings[p] then return end
    local d = {}
    if s.ESPBox then
        d.Box = Drawing.new("Square")
        d.Box.Thickness = s.ESPBoxThickness
        d.Box.Filled = false
        d.Box.Transparency = 1
        d.Box.Visible = false
    end
    if s.ESPName then
        d.Name = Drawing.new("Text")
        d.Name.Size = s.ESPTextSize
        d.Name.Center = true
        d.Name.Outline = true
        d.Name.OutlineColor = Color3.fromRGB(0,0,0)
        d.Name.Visible = false
    end
    if s.ESPHealth then
        d.HealthBar = Drawing.new("Line")
        d.HealthBar.Thickness = 2
        d.HealthBar.Visible = false
        d.HealthBarBG = Drawing.new("Line")
        d.HealthBarBG.Thickness = 2
        d.HealthBarBG.Color = Color3.fromRGB(0,0,0)
        d.HealthBarBG.Visible = false
    end
    if s.ESPDistance then
        d.Distance = Drawing.new("Text")
        d.Distance.Size = s.ESPTextSize - 2
        d.Distance.Center = true
        d.Distance.Outline = true
        d.Distance.OutlineColor = Color3.fromRGB(0,0,0)
        d.Distance.Visible = false
    end
    if s.ESPTracer then
        d.Tracer = Drawing.new("Line")
        d.Tracer.Thickness = 1
        d.Tracer.Visible = false
    end
    self.drawings[p] = d
end
function ESP:update(p, s, hub)
    local d = self.drawings[p]
    if not d then return end
    if not self:shouldDraw(p, s, hub) then for _, v in pairs(d) do pcall(function() v.Visible = false end) end return end
    local char = p.Character
    local head = char and char:FindFirstChild("Head")
    local hrp = Core.getHRP(p)
    local hum = Core.getHumanoid(p)
    if not head or not hrp then for _, v in pairs(d) do pcall(function() v.Visible = false end) end return end
    local hp, on1 = Camera:WorldToViewportPoint(head.Position)
    local rp, on2 = Camera:WorldToViewportPoint(hrp.Position)
    if not on1 and not on2 then for _, v in pairs(d) do pcall(function() v.Visible = false end) end return end
    local color = self:colorFor(p, s)
    local h = math.abs(hp.Y - rp.Y) * 1.6
    local w = h * 0.6
    local bx, by = hp.X - w/2, hp.Y - h*0.15
    if d.Box then
        d.Box.Size = Vector2.new(w, h)
        d.Box.Position = Vector2.new(bx, by)
        d.Box.Color = color
        d.Box.Visible = true
    end
    if d.Name then
        d.Name.Text = Identity.getDisplayName(p)
        d.Name.Position = Vector2.new(hp.X, by - 18)
        d.Name.Color = color
        d.Name.Visible = true
    end
    if d.HealthBar and hum then
        local r = Util.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local barX = bx - 8
        d.HealthBarBG.From = Vector2.new(barX, by)
        d.HealthBarBG.To = Vector2.new(barX, by + h)
        d.HealthBarBG.Visible = true
        d.HealthBar.From = Vector2.new(barX, by + h * (1 - r))
        d.HealthBar.To = Vector2.new(barX, by + h)
        d.HealthBar.Color = Color3.fromRGB(255*(1-r), 255*r, 0)
        d.HealthBar.Visible = true
    end
    if d.Distance then
        d.Distance.Text = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude) .. "m"
        d.Distance.Position = Vector2.new(hp.X, by + h + 2)
        d.Distance.Color = color
        d.Distance.Visible = true
    end
    if d.Tracer then
        local vp = Camera.ViewportSize
        d.Tracer.From = Vector2.new(vp.X/2, vp.Y)
        d.Tracer.To = Vector2.new(hp.X, hp.Y)
        d.Tracer.Color = color
        d.Tracer.Visible = true
    end
end
function ESP:step(hub)
    local s = hub.state
    if not s.ESPEnabled then
        for _, d in pairs(self.drawings) do for _, v in pairs(d) do pcall(function() v.Visible = false end) end end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if self:shouldDraw(p, s, hub) then
            if not self.drawings[p] then self:create(p, s) end
            self:update(p, s, hub)
        else
            if self.drawings[p] then for _, v in pairs(self.drawings[p]) do pcall(function() v.Visible = false end) end end
            if self.chams[p] then for _, h in pairs(self.chams[p]) do pcall(function() h:Destroy() end) end self.chams[p] = nil end
        end
    end
end

