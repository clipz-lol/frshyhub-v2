local Slots = {}
Slots.IndexFile = "FRShYHub_V2_Slots_Index.json"
Slots.SlotPrefix = "FRShYHub_V2_Slot_"
Slots.Index = {}
function Slots.loadIndex()
    local ok, data = pcall(function() return readfile(Slots.IndexFile) end)
    if ok and data and data ~= "" then
        local ok2, d = pcall(function() return HttpService:JSONDecode(data) end)
        if ok2 and type(d) == "table" then Slots.Index = d return true end
    end
    Slots.Index = {}
    return false
end
function Slots.saveIndex()
    pcall(function() writefile(Slots.IndexFile, HttpService:JSONEncode(Slots.Index)) end)
end
function Slots.newId() return tostring(math.floor(tick())) .. "_" .. Util.rand(6) end
function Slots.save(id, name, data)
    local payload = {meta = {name=name, id=id, created=Slots.Index[id] and Slots.Index[id].created or Util.timeStamp(), updated=Util.timeStamp()}, data=data}
    local ok = pcall(function() writefile(Slots.SlotPrefix .. id .. ".json", HttpService:JSONEncode(payload)) end)
    if ok then Slots.Index[id] = payload.meta Slots.saveIndex() end
    return ok
end
function Slots.load(id)
    local ok, data = pcall(function() return readfile(Slots.SlotPrefix .. id .. ".json") end)
    if not ok or not data or data == "" then return nil end
    local ok2, d = pcall(function() return HttpService:JSONDecode(data) end)
    if ok2 and type(d) == "table" and d.data then return d end
    return nil
end
function Slots.delete(id)
    pcall(function() if isfile and isfile(Slots.SlotPrefix .. id .. ".json") then delfile(Slots.SlotPrefix .. id .. ".json") end end)
    Slots.Index[id] = nil
    Slots.saveIndex()
    return true
end
function Slots.rename(id, newName)
    if not Slots.Index[id] then return false end
    Slots.Index[id].name = newName
    Slots.Index[id].updated = Util.timeStamp()
    Slots.saveIndex()
    local l = Slots.load(id)
    if l then
        l.meta.name = newName
        l.meta.updated = Util.timeStamp()
        pcall(function() writefile(Slots.SlotPrefix .. id .. ".json", HttpService:JSONEncode(l)) end)
    end
    return true
end
function Slots.list()
    local out = {}
    for id, meta in pairs(Slots.Index) do table.insert(out, {id=id, meta=meta}) end
    table.sort(out, function(a,b) return (a.meta.updated or "") > (b.meta.updated or "") end)
    return out
end
Slots.loadIndex()

