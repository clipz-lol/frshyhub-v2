local Identity = {}
function Identity.start(hub)
    local s = hub.state
    if hub.identityConn then hub.identityConn:Disconnect() hub.identityConn = nil end
    if not s.NameSpooferEnabled then return end
    local name = s.SpoofedName
    if not name or name == "" then name = "Spoofed" end
    local function apply()
        local char = LocalPlayer.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end
        local old = head:FindFirstChild("SpoofedNametag")
        if old then old:Destroy() end
        local bg = Instance.new("BillboardGui")
        bg.Name = "SpoofedNametag"
        bg.Adornee = head
        bg.Size = UDim2.new(0, 200, 0, 50)
        bg.StudsOffset = Vector3.new(0, 2.5, 0)
        bg.AlwaysOnTop = true
        bg.Parent = head
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 1, 0)
        l.BackgroundTransparency = 1
        l.Text = name
        l.TextColor3 = Color3.fromRGB(255,255,255)
        l.TextStrokeTransparency = 0
        l.TextStrokeColor3 = Color3.fromRGB(0,0,0)
        l.Font = Enum.Font.GothamBold
        l.TextSize = 14
        l.Parent = bg
    end
    apply()
    hub.identityConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        apply()
    end)
    hub:bind(hub.identityConn)
end
function Identity.stop(hub)
    if hub.identityConn then hub.identityConn:Disconnect() hub.identityConn = nil end
    local char = LocalPlayer.Character
    if char then
        local head = char:FindFirstChild("Head")
        if head then
            local old = head:FindFirstChild("SpoofedNametag")
            if old then old:Destroy() end
        end
    end
end
function Identity.getDisplayName(p)
    local ok, n = pcall(function() return p.DisplayName end)
    if ok and n and n ~= "" then return n end
    return p.Name
end

-- ============================================================
-- AIMBOT + SILENT AIM
-- ============================================================
local Aimbot = {}
local silentState = {conn=nil, touchConn=nil}
local function findTarget(hub)
    local s = hub.state
    local mouse = UserInputService:GetMouseLocation()
    local fov = s.AimFOV
    local wallCheck = s.WallCheck and not s.WallBangEnabled
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and Core.isAlive(p) then
            local skip = false
            if s.FriendProtection and hub:isProtected(p) then skip = true end
            if s.TeamCheck and LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then skip = true end
            if not skip then
                local part = hub:getHitboxPart(p.Character, s.AimHitbox)
                if part then
                    local pos = part.Position
                    local hrp = Core.getHRP(p)
                    if hrp and s.Prediction > 0 then pos = pos + hrp.AssemblyLinearVelocity * s.Prediction end
                    local sp, onScreen = Camera:WorldToViewportPoint(pos)
                    if onScreen then
                        local dist = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                        local passWall = true
                        if wallCheck then passWall = Core.isVisible(Camera.CFrame.Position, part, LocalPlayer.Character) end
                        if dist < fov and passWall and dist < bestDist then
                            bestDist = dist
                            best = {plr=p, part=part, pos=pos, screen=Vector2.new(sp.X, sp.Y), dist=dist,
                                    worldDist=(pos - Camera.CFrame.Position).Magnitude}
                        end
                    end
                end
            end
        end
    end
    return best
end
function Aimbot:fireSilent(hub)
    if not hub.state.SilentAim then return end
    local b = findTarget(hub)
    if not b then return end
    local mouse = UserInputService:GetMouseLocation()
    mousemoverel(b.screen.X - mouse.X, b.screen.Y - mouse.Y)
    hub.flags.lockedTarget = b.plr
end
function Aimbot:startSilent(hub)
    if silentState.conn then return end
    silentState.conn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if hub.state.SilentAim and hub.state.AimbotEnabled then Aimbot:fireSilent(hub) end
        end
    end)
    hub:bind(silentState.conn)
    silentState.touchConn = UserInputService.TouchStarted:Connect(function(_, gp)
        if gp then return end
        if hub.state.SilentAim and hub.state.AimbotEnabled then Aimbot:fireSilent(hub) end
    end)
    hub:bind(silentState.touchConn)
end
function Aimbot:stopSilent(hub)
    if silentState.conn then silentState.conn:Disconnect() silentState.conn = nil end
    if silentState.touchConn then silentState.touchConn:Disconnect() silentState.touchConn = nil end
end
function Aimbot:step(hub)
    local s = hub.state
    if not s.AimbotEnabled then hub.flags.lockedTarget = nil return end
    local b = findTarget(hub)
    if not b then hub.flags.lockedTarget = nil return end
    hub.flags.lockedTarget = b.plr
    if s.SilentAim then return end
    local mouse = UserInputService:GetMouseLocation()
    local dx, dy = b.screen.X - mouse.X, b.screen.Y - mouse.Y
    local lock = s.AimLockStrength or 1
    if s.SnapAimEnabled or lock >= 0.95 then
        if math.abs(dx) > 0.05 or math.abs(dy) > 0.05 then mousemoverel(dx, dy) end
    else
        local sf = s.Smoothness / 100
        local strength = 0.03 + lock * 0.97
        local eff = Util.clamp(strength * (1 - sf * 0.97), 0.03, 1)
        if math.abs(dx) < 2 and math.abs(dy) < 2 then eff = 1 end
        if math.abs(dx * eff) > 0.01 or math.abs(dy * eff) > 0.01 then mousemoverel(dx * eff, dy * eff) end
    end
end

