local Util = {}
function Util.clamp(v, a, b) return math.max(a, math.min(b, v)) end
function Util.color3(t) return Color3.fromRGB(t[1] or 0, t[2] or 0, t[3] or 0) end
function Util.accentPanel(t, f)
    f = f or 0.3
    return Color3.fromRGB(math.floor((t[1] or 0) * f), math.floor((t[2] or 0) * f), math.floor((t[3] or 0) * f))
end
function Util.rand(len)
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local out = {}
    for _ = 1, len do out[#out+1] = chars:sub(math.random(1, #chars), math.random(1, #chars)) end
    return table.concat(out)
end
function Util.timeStamp()
    local ok, d = pcall(function() return os.date("%Y-%m-%d %H:%M:%S") end)
    if ok then return d end
    return tostring(math.floor(tick()))
end
Util._conns = {}
function Util.track(c) table.insert(Util._conns, c) return c end
function Util.disconnectAll()
    for _, c in ipairs(Util._conns) do pcall(function() c:Disconnect() end) end
    Util._conns = {}
end

