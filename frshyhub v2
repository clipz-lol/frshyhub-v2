local AvatarChanger = {}

function AvatarChanger.parseCode(code)
    code = tostring(code or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if code == "" then return nil end
    code = code:gsub("^https?://", ""):gsub("^www%.", "")
    local urlUser = code:match("users/(%d+)")
    if urlUser then return "user", tonumber(urlUser) end
    local num = tonumber(code)
    if num then return "user", num end
    return nil
end

function AvatarChanger.clearCharacter(char)
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants")
           or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh")
           or child:IsA("BodyColors") then
            pcall(function() child:Destroy() end)
        end
    end
    local head = char:FindFirstChild("Head")
    if head then
        local face = head:FindFirstChild("face")
        if face then pcall(function() face:Destroy() end) end
    end
end

local function attachAccessory(char, humanoid, accessory)
    local clone = accessory:Clone()
    local handle = clone:FindFirstChild("Handle")
    if not handle then
        clone.Parent = char
        return true
    end

    if humanoid then
        local ok = pcall(function() humanoid:AddAccessory(clone) end)
        if ok and clone.Parent then
            return true
        end
    end

    clone.Parent = char
    local accType = tostring(clone:GetAttribute("AccessoryType") or
        (clone:FindFirstChildOfClass("Attachment") and "Hat") or "Hat")
    local target
    if string.find(accType, "Hat") or string.find(accType, "Hair") or string.find(accType, "Face") then
        target = char:FindFirstChild("Head")
    elseif string.find(accType, "Shirt") or string.find(accType, "Jacket") then
        target = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif string.find(accType, "Pant") then
        target = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    else
        target = char:FindFirstChild("Head")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
    end
    if target then
        handle.CFrame = target.CFrame
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = target
        weld.Parent = handle
    end
    return true
end

function AvatarChanger.applyViaApi(userId, hub)
    local ok, model = pcall(function()
        return Players:GetCharacterAppearanceAsync(userId)
    end)
    if not ok or not model then
        return false, 0, 0, "GetCharacterAppearanceAsync failed"
    end

    local char = LocalPlayer.Character
    if not char then return false, 0, 0, "No character" end
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    AvatarChanger.clearCharacter(char)

    local newBC = model:FindFirstChildOfClass("BodyColors")
    if newBC then
        pcall(function()
            local bc = newBC:Clone()
            bc.Parent = char
        end)
    end

    local accessories = {}
    for _, item in ipairs(model:GetDescendants()) do
        if item:IsA("Accessory") then table.insert(accessories, item) end
    end

    local inserted, failed = 0, 0

    for _, acc in ipairs(accessories) do
        local okAcc = pcall(function()
            attachAccessory(char, humanoid, acc)
        end)
        if okAcc then inserted += 1 else failed += 1 end
    end

    for _, item in ipairs(model:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic")
            or item:IsA("CharacterMesh") then
            local okItem = pcall(function()
                local clone = item:Clone()
                clone.Parent = char
            end)
            if okItem then inserted += 1 else failed += 1 end
        elseif item:IsA("Decal") then
            local head = char:FindFirstChild("Head")
            if head then
                local okDecal = pcall(function()
                    local clone = item:Clone()
                    clone.Name = "face"
                    clone.Parent = head
                end)
                if okDecal then inserted += 1 else failed += 1 end
            end
        end
    end

    pcall(function() model:Destroy() end)
    print(string.format("[FRShYHub Avatar] User %d: %d inserted, %d failed", userId, inserted, failed))
    return inserted > 0, inserted, failed
end

function AvatarChanger.applyCode(code, hub)
    if not code or code == "" then
        Notify.push("Avatar", "Enter a code first", "warn", 2)
        return false
    end
    local kind, value = AvatarChanger.parseCode(code)
    if not kind then
        Notify.push("Avatar", "Invalid — use a User ID like 156", "error", 3)
        return false
    end

    if kind == "user" then
        Notify.push("Avatar", "Fetching user " .. value .. "...", "info", 2)
        local ok, inserted, failed = AvatarChanger.applyViaApi(value, hub)
        if ok then
            local msg = string.format("Applied %d items", inserted)
            if failed > 0 then msg = msg .. " (" .. failed .. " failed)" end
            Notify.push("Avatar", msg, failed > 0 and "warn" or "success", 3)
            return true
        else
            Notify.push("Avatar", "Failed — check F9 console", "error", 4)
            return false
        end
    end
    return false
end

