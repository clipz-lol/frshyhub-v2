-- ATTACH
-- ============================================================
local attachState = {conn=nil, target=nil, active=false, origSpeed=16, origJump=50, origJumpH=7.2}
function Hub:attachTo(p)
    if not p or not Core.isAlive(p) then Notify.push("Attach", "Invalid target", "error", 2) return false end
    self:detach()
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = Core.getHumanoid(LocalPlayer)
    if not hrp or not hum then return false end
    attachState.origSpeed = hum.WalkSpeed
    attachState.origJump = hum.JumpPower
    attachState.origJumpH = hum.JumpHeight
    attachState.target = p
    attachState.active = true
    hum.PlatformStand = true
    hum.WalkSpeed = 0
    attachState.conn = RunService.RenderStepped:Connect(function()
        if not attachState.active or not Core.isAlive(attachState.target) then self:detach() return end
        local tHrp = Core.getHRP(attachState.target)
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp or not tHrp then return end
        local s = self.state
        local offset = CFrame.new(s.AttachOffsetX, s.AttachOffsetY, s.AttachOffsetZ)
        if s.AttachLockRotation then myHrp.CFrame = tHrp.CFrame * offset
        else myHrp.CFrame = CFrame.new(tHrp.CFrame * offset) * (myHrp.CFrame - myHrp.CFrame.Position) end
    end)
    self:bind(attachState.conn)
    Notify.push("Attach", "Attached to " .. p.Name, "success", 2)
    return true
end
function Hub:detach()
    if attachState.conn then attachState.conn:Disconnect() attachState.conn = nil end
    if attachState.active then
        local hum = Core.getHumanoid(LocalPlayer)
        if hum then
            hum.PlatformStand = false
            hum.WalkSpeed = attachState.origSpeed
            if hum.UseJumpPower then hum.JumpPower = attachState.origJump else hum.JumpHeight = attachState.origJumpH end
        end
        Notify.push("Attach", "Detached", "warn", 1.5)
    end
    attachState.active = false
    attachState.target = nil
end

